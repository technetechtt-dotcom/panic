{
  "name": "@guardian/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run build -w @guardian/shared-types && npm run build -w @guardian/shared-validation",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build -w @guardian/shared-types && npm run build -w @guardian/shared-validation",
    "dev": "node --env-file=../../.env --import tsx --watch src/main.ts",
    "dev:postgres": "node scripts/dev-postgres.mjs",
    "start": "node dist/main.js",
    "test": "cross-env NODE_ENV=test JWT_ACCESS_SECRET=test-secret-that-is-long-enough-for-hs256 DATABASE_URL=postgresql://guardian:change-me@127.0.0.1:5432/guardian?schema=public REDIS_URL= tsx --test src/domain/domain.test.ts src/domain/protection.test.ts src/domain/operations.test.ts src/common/rate-limit.test.ts src/http/api.http.test.ts src/infra/postgres.integration.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "seed:operator": "node --env-file=../../.env --import tsx scripts/seed-operator.ts"
  },
  "dependencies": {
    "@guardian/shared-types": "*",
    "@guardian/shared-validation": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "^6.16.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
