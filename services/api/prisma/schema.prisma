generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  GUARDIAN
  MONITOR_OPERATOR
  SUPERVISOR
  RESPONDER
  ADMIN
}

enum IncidentState {
  PROTECTED
  CONCERN
  HIGH_RISK
  SOS
  ACKNOWLEDGED
  RESPONDING
  USER_LOCATED
  RESOLVED
  ARCHIVED
}

enum TriggerType {
  VOLUME_BUTTON
  VOICE_SAFE_WORD
  MANUAL_SOS
  JOURNEY_TIMEOUT
  WEARABLE
  FALL_OR_IMPACT
  SAFETY_CHECK_FAILURE
  DURESS
  SYSTEM_RISK_ESCALATION
}

enum ContactStatus {
  ONLINE
  DEVICE_CONTACT_LOST
}

model User {
  id              String          @id @db.Uuid
  email           String          @unique
  passwordHash    String
  displayName     String
  role            Role            @default(USER)
  phone           String?
  emailVerifiedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  devices         Device[]
  incidents       Incident[]
  refreshTokens   RefreshToken[]
  consents        ConsentRecord[]
  auditEvents     AuditEvent[]    @relation("AuditActor")
  safetyPin       SafetyPin?
  guardians       TrustedContact[]
  journeys        ProtectionSession[]
  profile         EmergencyProfile?
  mfa             OperatorMfa?
  assignments     ResponderAssignment[]
  recoveries      RecoveryToken[]
}

model RecoveryToken {
  id          String    @id @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  purpose     String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model ConsentRecord {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  purpose   String
  version   String
  granted   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Device {
  id             String     @id @db.Uuid
  userId         String     @db.Uuid
  devicePublicId String     @db.Uuid
  platform       String
  manufacturer   String?
  model          String?
  osVersion      String
  appVersion     String
  publicKey          String?
  emergencyTokenHash String?
  fcmToken           String?
  revokedAt          DateTime?
  lastSeenAt         DateTime?
  nickname           String?
  pushTokenUpdatedAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidents          Incident[]

  @@unique([userId, devicePublicId])
  @@index([userId])
  @@index([emergencyTokenHash])
}

model Incident {
  id                 String            @id @db.Uuid
  userId             String            @db.Uuid
  deviceId           String            @db.Uuid
  triggerId          String            @unique @db.Uuid
  triggerType        TriggerType
  requestHash        String
  state              IncidentState
  isTest             Boolean           @default(false)
  duress             Boolean           @default(false)
  correlationId      String            @db.Uuid
  protectionMode     String
  contactStatus      ContactStatus     @default(ONLINE)
  contactLostAt      DateTime?
  capsuleJson        Json
  lastHeartbeatAt    DateTime?
  lastPositionAt     DateTime?
  lastLatitude       Float?
  lastLongitude      Float?
  lastAccuracy       Float?
  lastSpeed          Float?
  lastHeading        Float?
  lastBattery        Float?
  acknowledgedAt     DateTime?
  acknowledgedById   String?           @db.Uuid
  resolvedAt         DateTime?
  resolvedById       String?           @db.Uuid
  claimedBy          String?
  claimedAt          DateTime?
  escalatedToSupervisorAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id])
  device             Device            @relation(fields: [deviceId], references: [id])
  locations          IncidentLocation[]
  heartbeats         DeviceHeartbeat[]
  timeline           TimelineEvent[]
  escalations        IncidentEscalation[]
  evidence           EvidenceChunk[]
  deliveries         NotificationDelivery[]
  rooms              IncidentRoom[]
  assignments        ResponderAssignment[]

  @@index([state, isTest, createdAt])
  @@index([userId, createdAt])
  @@index([correlationId])
}

model IncidentLocation {
  id            String   @id @db.Uuid
  incidentId    String   @db.Uuid
  clientPointId String   @db.Uuid
  latitude      Float
  longitude     Float
  accuracy      Float?
  speed         Float?
  bearing       Float?
  altitude      Float?
  recordedAt    DateTime
  source        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, clientPointId])
  @@index([incidentId, recordedAt])
}

model DeviceHeartbeat {
  id                 String   @id @db.Uuid
  incidentId         String   @db.Uuid
  clientHeartbeatId  String   @db.Uuid
  recordedAt         DateTime
  latitude           Float?
  longitude          Float?
  accuracy           Float?
  speed              Float?
  heading            Float?
  batteryLevel       Float?
  charging           Boolean
  networkType        String
  deviceOnline       Boolean
  evidenceStatus     String
  permissionsStatus  String
  batteryMode        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  incident           Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, clientHeartbeatId])
  @@index([incidentId, recordedAt])
}

model TimelineEvent {
  id         String   @id @db.Uuid
  incidentId String   @db.Uuid
  type       String
  message    String
  occurredAt DateTime
  actorId    String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, occurredAt])
}

model AuditEvent {
  id            String   @id @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  entityType    String
  entityId      String
  correlationId String?
  requestId     String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([createdAt])
}

model IncidentEscalation {
  id          String      @id @db.Uuid
  incidentId  String      @db.Uuid
  triggerId   String      @unique @db.Uuid
  triggerType TriggerType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  incident    Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model SafetyPin {
  userId         String   @id @db.Uuid
  cancelPinHash  String
  duressPinHash  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrustedContact {
  id                 String   @id @db.Uuid
  userId             String   @db.Uuid
  displayName        String
  phone              String?
  email              String?
  canViewLocation    Boolean  @default(false)
  canViewEvidence    Boolean  @default(false)
  canCancelIncident  Boolean  @default(false)
  relationship       String   @default("FRIEND")
  priority           Int      @default(1)
  notificationMethods String  @default("PUSH,SMS")
  guardianUserId     String?  @db.Uuid
  invitationStatus   String   @default("ACCEPTED")
  invitationToken    String?  @unique
  verifiedAt         DateTime?
  lastNotifiedAt     DateTime?
  lastAcknowledgedAt DateTime?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProtectionSession {
  id                      String   @id @db.Uuid
  userId                  String   @db.Uuid
  destinationLabel        String
  expectedArrivalAt       DateTime
  checkInIntervalSeconds  Int
  lastCheckInAt           DateTime
  status                  String
  mode                    String   @default("WALK")
  originLatitude          Float?
  originLongitude         Float?
  destinationLatitude     Float?
  destinationLongitude    Float?
  corridorMeters          Int      @default(400)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model RiskSignal {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  sessionId String   @db.Uuid
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, type])
  @@index([userId])
}

model EvidenceChunk {
  id            String   @id @db.Uuid
  incidentId    String   @db.Uuid
  clientChunkId String   @db.Uuid
  sequence      Int
  sha256        String
  contentType   String
  byteLength    Int
  storageKey    String?
  payload       Bytes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, clientChunkId])
  @@index([incidentId, sequence])
}

model EmergencyProfile {
  userId      String   @id @db.Uuid
  bloodType   String?
  allergies   String?
  medications String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OperatorMfa {
  userId    String   @id @db.Uuid
  secret    String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id                String    @id @db.Uuid
  incidentId        String    @db.Uuid
  channel           String
  destination       String
  status            String
  detail            String
  providerMessageId String?
  attemptNumber     Int       @default(1)
  queuedAt          DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureCode       String?
  openedAt          DateTime?
  acknowledgedAt    DateTime?
  createdAt         DateTime  @default(now())
  incident          Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model EvidenceAccessLog {
  id         String   @id @db.Uuid
  incidentId String   @db.Uuid
  evidenceId String
  actorId    String?  @db.Uuid
  action     String
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

model IncidentRoom {
  id               String   @id @db.Uuid
  incidentId       String   @db.Uuid
  tokenHash        String   @unique
  guardianName     String?
  acknowledgedAt   DateTime?
  canViewLocation  Boolean
  canViewEvidence  Boolean
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  incident         Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model ResponderAssignment {
  id              String    @id @db.Uuid
  incidentId      String    @db.Uuid
  responderId     String    @db.Uuid
  status          String
  assignedAt      DateTime?
  acceptedAt      DateTime?
  enRouteAt       DateTime?
  arrivedAt       DateTime?
  locatedAt       DateTime?
  declinedAt      DateTime?
  completedAt     DateTime?
  assignedBy      String?
  lastLatitude    Float?
  lastLongitude   Float?
  lastLocationAt  DateTime?
  speedMps        Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  incident        Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  responder       User      @relation(fields: [responderId], references: [id])

  @@unique([incidentId, responderId])
}

model ResponderProfile {
  id           String   @id @db.Uuid
  userId       String   @unique @db.Uuid
  team         String?
  region       String?
  capabilities String?
  vehicle      String?
  phone        String?
  availability String   @default("AVAILABLE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OutboxEvent {
  id            String    @id @db.Uuid
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(8)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  lockedBy      String?
  lockedAt      DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}

model OutboxDeadLetter {
  id            String   @id @db.Uuid
  outboxEventId String   @unique @db.Uuid
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  attempts      Int
  lastError     String
  failedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
}

model SchedulerLock {
  name        String   @id
  lockedBy    String
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

model OperatorShift {
  id           String    @id @db.Uuid
  operatorId   String    @db.Uuid
  status       String
  startedAt    DateTime
  readyAt      DateTime?
  handoverNote String?
  handoverToId String?   @db.Uuid
  endedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([operatorId, status])
  @@index([status])
}

model AiModel {
  id          String   @id @db.Uuid
  name        String
  version     String
  purpose     String
  status      String
  datasetNote String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, version])
}

model AiDecision {
  id              String   @id @db.Uuid
  incidentId      String   @db.Uuid
  modelName       String
  modelVersion    String
  mode            String
  level           String
  confidence      Float
  explanation     String
  contributing    Json
  contradicting   Json
  featureSnapshot Json
  createdAt       DateTime @default(now())

  @@index([incidentId, mode, createdAt])
}

model AiRecommendation {
  id          String    @id @db.Uuid
  incidentId  String    @db.Uuid
  decisionId  String    @db.Uuid
  action      String
  reason      String
  status      String
  decidedById String?   @db.Uuid
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([incidentId, status])
}

model AiIncidentSummary {
  id           String   @id @db.Uuid
  incidentId   String   @db.Uuid
  summary      String
  changes      String
  risks        String
  modelVersion String
  createdAt    DateTime @default(now())

  @@index([incidentId, createdAt])
}

model AiReview {
  id         String   @id @db.Uuid
  incidentId String   @db.Uuid
  actorId    String   @db.Uuid
  targetType String
  targetId   String
  status     String
  note       String
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

model SearchPrediction {
  id         String   @id @db.Uuid
  incidentId String   @db.Uuid
  kind       String
  label      String
  confidence Float
  geometry   Json
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}
