# Copy to .env and replace every empty secret before running.
# Never commit .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=guardian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guardian
DATABASE_URL=postgresql://guardian:change-me@localhost:5432/guardian?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT access tokens are signed with this secret. Minimum 32 characters.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:5173

# A device is marked DEVICE_CONTACT_LOST after this many seconds without a heartbeat.
HEARTBEAT_STALE_AFTER_SECONDS=45

# Optional operator seed. The seed script refuses to run when the password is empty.
MONITOR_OPERATOR_EMAIL=
MONITOR_OPERATOR_PASSWORD=

# Monitoring web (Vite). Leave empty in local dev to use the Vite proxy.
VITE_API_BASE_URL=
# Production tile server. Do not rely on the public OpenStreetMap tile server in production.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Deep links emailed for verify/reset/invite. Production requires SMTP_URL.
DEEP_LINK_BASE=https://links.guardian.app
# SHA-256 certificate fingerprint used to generate /.well-known/assetlinks.json on the links/web host.
GUARDIAN_ANDROID_CERT_SHA256=
GUARDIAN_ANDROID_PACKAGE=za.co.guardian.app
PUBLIC_API_URL=http://localhost:3000
SMTP_URL=
SMTP_FROM=Guardian <no-reply@guardian.app>
# Production nginx requires a certificate. 1 generates a 30-day self-signed lab certificate. It is not a public certificate.
GUARDIAN_TLS_SELF_SIGNED=
GUARDIAN_TLS_CN=localhost

# Off-host backups (optional). Restore verification must use a throwaway DB.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=guardian/db
# Required by production backup jobs. Use a high-entropy secret stored in the deployment secret manager.
BACKUP_ENCRYPTION_KEY=
BACKUP_VERIFY_DATABASE_URL=
LAST_BACKUP_AT=


# Competition/staging demo. Keep disabled in live production.
GUARDIAN_DEMO_MODE=false
GUARDIAN_DEMO_PASSWORD=
# Explicit destinations used only by the supervised Integrations test buttons.
INTEGRATION_TEST_PHONE=
INTEGRATION_TEST_EMAIL=
INTEGRATION_TEST_FCM_TOKEN=
INTEGRATION_TEST_GEOCODE_QUERY=Kimberley, South Africa

# Journey geocoder. Production must use an approved/self-hosted HTTPS provider, not public Nominatim.
GEOCODER_URL=
GEOCODER_USER_AGENT=Guardian/0.1 (journey-protection)

# Evidence encryption and authoritative object storage.
EVIDENCE_VAULT_KEY=
EVIDENCE_REMOTE_REQUIRED=false
EVIDENCE_RETENTION_DAYS=365
EVIDENCE_RETENTION_POLICY=STANDARD
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Guardian delivery providers. Configure complete groups only.
# Production compose sets this true so at least one emergency delivery provider must be live.
GUARDIAN_REQUIRE_DELIVERY_PROVIDER=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false

# Reverse-proxy trust is mandatory in production.
TRUST_PROXY=false
