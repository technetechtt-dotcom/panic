# Copy to .env and replace every empty secret before running.
# Never commit .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=guardian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guardian
DATABASE_URL=postgresql://guardian:change-me@localhost:5432/guardian?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT access tokens are signed with this secret. Minimum 32 characters.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:5173

# A device is marked DEVICE_CONTACT_LOST after this many seconds without a heartbeat.
HEARTBEAT_STALE_AFTER_SECONDS=45

# Optional operator seed. The seed script refuses to run when the password is empty.
MONITOR_OPERATOR_EMAIL=
MONITOR_OPERATOR_PASSWORD=

# Monitoring web (Vite). Leave empty in local dev to use the Vite proxy.
VITE_API_BASE_URL=
# Production tile server. Do not rely on the public OpenStreetMap tile server in production.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
